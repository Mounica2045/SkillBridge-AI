datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  avatar           String?
  educationLevel   String?
  fieldOfStudy     String?
  experienceLevel  String?  @default("Beginner")
  targetCareerId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  skills            UserSkill[]
  bookmarks         Bookmark[]
  milestoneProgress UserMilestoneProgress[]
  aiChats           AIChat[]
  progress          UserProgress?
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // Frontend, Backend, Database, Design, Data, Soft Skills, etc.
  description String?

  userSkills  UserSkill[]
  careerReqs  CareerSkillRequirement[]
}

model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  skillId     String
  proficiency String   // Beginner, Intermediate, Advanced, Expert
  verified    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model CareerFramework {
  id          String   @id @default(uuid())
  title       String   @unique
  slug        String   @unique
  description String
  category    String
  demandLevel String   @default("High") // High, Very High, Medium
  avgSalary   String?

  skillRequirements CareerSkillRequirement[]
  roadmaps          Roadmap[]
}

model CareerSkillRequirement {
  id                  String   @id @default(uuid())
  frameworkId         String
  skillId             String
  importance          String   @default("Core") // Core, Recommended, Optional
  requiredProficiency String   @default("Intermediate") // Beginner, Intermediate, Advanced, Expert

  framework CareerFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  skill     Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, skillId])
}

model LearningResource {
  id             String   @id @default(uuid())
  title          String
  description    String
  category       String   // Course, Tutorial, Documentation, Book, Project
  difficulty     String   // Beginner, Intermediate, Advanced
  url            String
  provider       String   // Coursera, Udemy, MDN, FreeCodeCamp, Youtube, etc.
  skillTags      String   // Comma-separated or JSON
  estimatedHours Int      @default(10)
  isVerified     Boolean  @default(true)
  isSample       Boolean  @default(false)
  createdAt      DateTime @default(now())

  bookmarks Bookmark[]
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String
  resourceId  String
  isCompleted Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model Roadmap {
  id                String   @id @default(uuid())
  careerFrameworkId String
  title             String
  description       String
  createdAt         DateTime @default(now())

  careerFramework CareerFramework    @relation(fields: [careerFrameworkId], references: [id], onDelete: Cascade)
  milestones      RoadmapMilestone[]
}

model RoadmapMilestone {
  id           String   @id @default(uuid())
  roadmapId    String
  stepOrder    Int
  title        String
  description  String
  skillsJson   String   // JSON string array of skills covered
  tasksJson    String   // JSON string array of actionable tasks
  projectsJson String   // JSON string array of sample projects

  roadmap Roadmap                 @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  progress UserMilestoneProgress[]
}

model UserMilestoneProgress {
  id             String   @id @default(uuid())
  userId         String
  milestoneId    String
  isCompleted    Boolean  @default(false)
  completedTasks String   @default("[]") // JSON string array of completed task indices/titles
  updatedAt      DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
}

model AIChat {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("Career Guidance Chat")
  createdAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
}

model AIMessage {
  id        String   @id @default(uuid())
  chatId    String
  role      String   // user, assistant
  content   String
  createdAt DateTime @default(now())

  chat AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id                    String   @id @default(uuid())
  userId                String   @unique
  studyHours            Int      @default(0)
  skillsLearnedCount    Int      @default(0)
  coursesCompletedCount Int      @default(0)
  readinessScore        Int      @default(0)
  weeklyActivityJson    String   @default("[{\"day\":\"Mon\",\"hours\":2},{\"day\":\"Tue\",\"hours\":3.5},{\"day\":\"Wed\",\"hours\":1.5},{\"day\":\"Thu\",\"hours\":4},{\"day\":\"Fri\",\"hours\":2.5},{\"day\":\"Sat\",\"hours\":5},{\"day\":\"Sun\",\"hours\":3}]")
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
